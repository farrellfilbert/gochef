<IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/wasm
    AddOutputFilterByType DEFLATE font/opentype application/x-font-ttf application/x-font-opentype
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(wasm|css|png|jpg|jpeg|gif|ico|ttf|otf|woff|woff2|svg|frag|bin)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddEncoding gzip .gz
</IfModule>
